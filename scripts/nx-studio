#!/bin/sh
set -eu

export WINEPREFIX="${NX_STUDIO_WINEPREFIX:-$HOME/.local/share/nx-studio/prefix}"
nx_exe="$WINEPREFIX/drive_c/Program Files/Nikon/NXStudio/NXStudio.exe"

if ! command -v wine >/dev/null 2>&1; then
  printf '%s\n' 'nx-studio: required command not found: wine' >&2
  exit 127
fi
if [ ! -f "$nx_exe" ]; then
  printf 'nx-studio: NX Studio is not installed in %s\n' "$WINEPREFIX" >&2
  exit 1
fi

exec wine "$nx_exe" "$@"
