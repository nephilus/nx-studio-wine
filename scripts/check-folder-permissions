#!/bin/sh
set -eu

usage() {
  printf 'Usage: %s /path/to/photo-folder\n' "$0" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
folder=$1
[ -d "$folder" ] || {
  printf 'Folder not found: %s\n' "$folder" >&2
  exit 1
}

export WINEPREFIX="${NX_STUDIO_WINEPREFIX:-$HOME/.local/share/nx-studio/prefix}"
for command in wine winepath; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'Required command not found: %s\n' "$command" >&2
    exit 127
  }
done

if [ ! -w "$folder" ] || [ ! -x "$folder" ]; then
  printf 'Host user cannot write/search: %s\n' "$folder" >&2
  exit 1
fi

windows_folder=$(winepath -w "$folder")
probe=nx-studio-permission-probe-$$
windows_probe="$windows_folder\\$probe"

cleanup() {
  wine cmd /c del "$windows_probe\\write-test.txt" >/dev/null 2>&1 || true
  wine cmd /c rmdir "$windows_probe" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

wine cmd /c mkdir "$windows_probe"
wine cmd /c echo nx-studio-write-ok '>' "$windows_probe\\write-test.txt"
wine cmd /c type "$windows_probe\\write-test.txt" | grep -q nx-studio-write-ok

printf 'Writable from Wine: %s\n' "$folder"
